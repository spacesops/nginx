# Copy on the server: cp members-stack.env.example members-stack.env && chmod 600 members-stack.env
# Generate secret: openssl rand -hex 32

SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
FABRIC_SEEDS=https://relay-atlas.spacesprotocol.org
FABRIC_DEV_MODE=false
FABRIC_SEARCH_TIMEOUT=120
FABRIC_BIN=/opt/bitvocation/certrelay/target/release/fabric

# Optional tiers
# FOUNDERS_NPUBS=npub1...
MEMBER_SPACE_SUFFIXES=bitvocation,bitcoin

# lookupd listen (run-members-stack.sh sets BIND when starting)
# BIND=127.0.0.1:8787
